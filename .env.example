POSTGRES_DB=bobill
POSTGRES_USER=bobill_user
POSTGRES_PASSWORD=replace_with_strong_password

PGADMIN_DEFAULT_EMAIL=admin@bobill.local
PGADMIN_DEFAULT_PASSWORD=replace_with_strong_password
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False
PGADMIN_REPLACE_SERVERS_ON_STARTUP=True
PGADMIN_SERVER_JSON_FILE=/pgadmin4/servers.json
PGPASS_FILE=/pgpass

DATABASE_URL=postgresql://bobill_user:replace_with_strong_password@localhost:5432/bobill?schema=public
AUTH_SECRET=replace_with_long_random_secret

# ngrok tunnel (only needed when running with --profile ngrok)
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=replace_with_ngrok_authtoken
# Static domain from: https://dashboard.ngrok.com/domains
NGROK_URL=your-static-subdomain.ngrok-free.dev
