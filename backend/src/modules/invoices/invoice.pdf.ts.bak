import PDFDocument from "pdfkit";
import { selectPdfFonts, decodeDataUrlImage, formatMoney } from "../../shared/pdf-fonts.js";
import { INVOICE_PDF_CONFIG } from "./invoice-pdf.config.js";

type InvoiceForPdf = {
  invoiceNumber: string;
  documentDate: Date;
  sellerCompanyName: string;
  sellerAddress: string;
  sellerTaxId: string | null;
  sellerPhone: string | null;
  sellerEmail: string | null;
  includeBuyer?: boolean;
  buyerCompanyName: string | null;
  buyerAddress: string | null;
  buyerTaxId: string | null;
  paymentTerms: string | null;
  creditDays: number | null;
  subtotal: unknown;
  discountTotal: unknown;
  grandTotal: unknown;
  note: string | null;
  amountInWords: string | null;
  signatures?: unknown;
  items: Array<{
    lineNo: number;
    description: string;
    quantity: unknown;
    unitPrice: unknown;
    lineTotal: unknown;
  }>;
};

type SignatureBlock = {
  dottedText?: string;
  bracketText?: string;
  imageDataUrl?: string;
};

type InvoiceSignatures = {
  approvedBy?: SignatureBlock;
  receivedBy?: SignatureBlock;
  payer?: SignatureBlock;
};

type PdfRow = InvoiceForPdf["items"][number];

export type InvoiceAutoFitSettings = {
  fontSize: number;
  rowPadding: number;
  headerGap: number;
};

const PAGE_MARGIN = INVOICE_PDF_CONFIG.pageMargin;
const TABLE_HEADER_HEIGHT = 18;
const CELL_PADDING_X = 4;
const TABLE_HEADERS = ["ลำดับ", "รายการสินค้า / บริการ", "จำนวน", "ราคา / หน่วย", "จำนวนเงิน"] as const;
const SIZE_TITLE = 16;
const SIZE_SUBTITLE = 11;
const SIZE_BODY = 9;
const SIZE_SIGNATURE = 9;
const MIN_FONT_SIZE = 8;
const FOOTER_BOTTOM = 8;
const FOOTER_SIGNATURE_HEIGHT = 66;
const SUMMARY_ROW_HEIGHT = 12;
const SUMMARY_ROW_GAP = 1;
const FREE_ITEMS_HEADING_GAP = 4;
const FREE_ITEMS_HEADING = "รายชื่อ (ราคาต่อหน่วย 0.00 บาท)";
const OVERFLOW_WARNING = "คำเตือน: รายการมากเกินไป อาจอ่านยาก";

const compactLineGap = (fontSize: number): number => -fontSize * 0.7;

export const getInvoiceAutoFitSettings = (itemCount: number): InvoiceAutoFitSettings => {
  if (!Number.isInteger(itemCount) || itemCount < 0) {
    throw new RangeError("Invoice item count must be a non-negative integer");
  }
  if (itemCount <= 10) return { fontSize: 12, rowPadding: 6, headerGap: 8 };
  if (itemCount <= 18) return { fontSize: 11, rowPadding: 4, headerGap: 6 };
  if (itemCount <= 28) return { fontSize: 10, rowPadding: 2, headerGap: 4 };
  if (itemCount <= 38) return { fontSize: 9, rowPadding: 1, headerGap: 2 };
  return { fontSize: 8, rowPadding: 1, headerGap: 0 };
};

const parseSignatures = (value: unknown): InvoiceSignatures => {
  if (!value || typeof value !== "object") return {};
  return value as InvoiceSignatures;
};

const measureTextHeight = (
  doc: PDFKit.PDFDocument,
  text: string,
  width: number,
  font: string,
  size: number,
): number => {
  doc.font(font).fontSize(size);
  return doc.heightOfString(text, { width, lineGap: compactLineGap(size) });
};

const writeText = (
  doc: PDFKit.PDFDocument,
  text: string,
  x: number,
  y: number,
  width: number,
  font: string,
  size: number,
  align: "left" | "center" | "right" | "justify" = "left",
): number => {
  const height = measureTextHeight(doc, text, width, font, size);
  doc.font(font).fontSize(size).text(text, x, y, { width, align, lineGap: compactLineGap(size) });
  return height;
};

const drawFullHeader = (
  doc: PDFKit.PDFDocument,
  invoice: InvoiceForPdf,
  fontNames: ReturnType<typeof selectPdfFonts>,
  gap: number,
): number => {
  const contentWidth = doc.page.width - PAGE_MARGIN * 2;
  let y = PAGE_MARGIN;
  y += writeText(doc, invoice.sellerCompanyName, PAGE_MARGIN, y, contentWidth, fontNames.bold, SIZE_TITLE, "center") + gap;
  y += writeText(doc, invoice.sellerAddress, PAGE_MARGIN, y, contentWidth, fontNames.regular, SIZE_SUBTITLE, "center") + 1;
  y += writeText(
    doc,
    `เลขประจำตัวผู้เสียภาษี: ${invoice.sellerTaxId ?? "-"}   เบอร์โทร: ${invoice.sellerPhone ?? "-"}   อีเมล: ${invoice.sellerEmail ?? "-"}`,
    PAGE_MARGIN,
    y,
    contentWidth,
    fontNames.regular,
    SIZE_SUBTITLE,
    "center",
  ) + gap;
  y += writeText(doc, "ใบแจ้งหนี้", PAGE_MARGIN, y, contentWidth, fontNames.bold, 18, "center") + gap;

  const details = [
    `เลขที่ใบแจ้งหนี้: ${invoice.invoiceNumber}`,
    `วันที่: ${invoice.documentDate.toLocaleDateString("th-TH")}`,
    `เงื่อนไขการชำระเงิน: ${invoice.paymentTerms ?? "-"}`,
    `เครดิต: ${invoice.creditDays ?? "-"} วัน`,
  ];
  for (const detail of details) {
    y += writeText(doc, detail, PAGE_MARGIN, y, contentWidth, fontNames.regular, SIZE_BODY) + 1;
  }

  if (invoice.includeBuyer !== false) {
    y += gap;
    const buyerDetails = [
      `ผู้ซื้อ: ${invoice.buyerCompanyName ?? "-"}`,
      `ที่อยู่: ${invoice.buyerAddress ?? "-"}`,
      `เลขประจำตัวผู้เสียภาษี: ${invoice.buyerTaxId ?? "-"}`,
    ];
    for (const detail of buyerDetails) {
      y += writeText(doc, detail, PAGE_MARGIN, y, contentWidth, fontNames.regular, SIZE_BODY) + 1;
    }
  }

  return y + gap;
};

const getTableWidths = (doc: PDFKit.PDFDocument): number[] => {
  const width = doc.page.width - PAGE_MARGIN * 2;
  return [width * 0.07, width * 0.45, width * 0.12, width * 0.17, width * 0.19];
};

const getRowValues = (row: PdfRow): string[] => [
  String(row.lineNo),
  row.description || "-",
  formatMoney(row.quantity),
  formatMoney(row.unitPrice),
  formatMoney(row.lineTotal),
];

const measureTableRowHeight = (
  doc: PDFKit.PDFDocument,
  row: PdfRow,
  widths: number[],
  fontName: string,
  fontSize: number,
  padding: number,
): number => {
  const textHeight = getRowValues(row).reduce((largest, value, index) => {
    const cellWidth = (widths[index] ?? 0) - CELL_PADDING_X * 2;
    return Math.max(largest, measureTextHeight(doc, value, cellWidth, fontName, fontSize));
  }, 0);
  return Math.ceil(textHeight + padding * 2);
};

const isFreeName = (row: PdfRow): boolean =>
  Number(row.unitPrice) === 0 && /^[\p{L}\p{M}][\p{L}\p{M}\s.'’()-]{1,79}$/u.test(row.description.trim());

type InvoiceLayoutRow =
  | { kind: "item"; item: PdfRow }
  | { kind: "free-names"; items: [PdfRow, PdfRow] };

export const arrangeInvoiceRows = (items: PdfRow[]): InvoiceLayoutRow[] => {
  if (items.length < 2 || !items.every(isFreeName)) {
    return items.map((item) => ({ kind: "item", item }));
  }

  const layout: InvoiceLayoutRow[] = [];
  for (let index = 0; index < items.length; index += 2) {
    const first = items[index];
    const second = items[index + 1];
    if (!first) continue;
    if (second) layout.push({ kind: "free-names", items: [first, second] });
    else layout.push({ kind: "item", item: first });
  }
  return layout;
};

const measureFreeItemsHeadingHeight = (
  doc: PDFKit.PDFDocument,
  fontName: string,
  fontSize: number,
  width: number,
): number => Math.ceil(measureTextHeight(doc, FREE_ITEMS_HEADING, width, fontName, fontSize)) + FREE_ITEMS_HEADING_GAP;

const freeNameText = (item: PdfRow): string =>
  `${item.lineNo}. ${item.description} (จำนวน ${formatMoney(item.quantity)})`;

const measureFreeNameRowHeight = (
  doc: PDFKit.PDFDocument,
  items: [PdfRow, PdfRow],
  contentWidth: number,
  fontName: string,
  fontSize: number,
  padding: number,
): number => {
  const cellWidth = contentWidth / 2 - CELL_PADDING_X * 2;
  return Math.ceil(Math.max(
    ...items.map((item) => measureTextHeight(doc, freeNameText(item), cellWidth, fontName, fontSize)),
  ) + padding * 2);
};

const drawTableHeader = (
  doc: PDFKit.PDFDocument,
  y: number,
  widths: number[],
  fontNames: ReturnType<typeof selectPdfFonts>,
  fontSize: number,
): number => {
  let x = PAGE_MARGIN;
  TABLE_HEADERS.forEach((label, index) => {
    const width = widths[index] ?? 0;
    doc.rect(x, y, width, TABLE_HEADER_HEIGHT).stroke();
    doc.font(fontNames.bold).fontSize(fontSize).text(label, x + CELL_PADDING_X, y + 3, {
      width: width - CELL_PADDING_X * 2,
      height: TABLE_HEADER_HEIGHT - 6,
      align: index >= 2 ? "right" : "left",
      lineBreak: false,
      ellipsis: true,
    });
    x += width;
  });
  return y + TABLE_HEADER_HEIGHT;
};

const drawItemRow = (
  doc: PDFKit.PDFDocument,
  row: PdfRow,
  y: number,
  rowHeight: number,
  widths: number[],
  fontNames: ReturnType<typeof selectPdfFonts>,
  fontSize: number,
  padding: number,
): void => {
  let x = PAGE_MARGIN;
  getRowValues(row).forEach((value, index) => {
    const width = widths[index] ?? 0;
    doc.rect(x, y, width, rowHeight).stroke();
    doc.font(fontNames.regular).fontSize(fontSize).text(value, x + CELL_PADDING_X, y + padding, {
      width: width - CELL_PADDING_X * 2,
      height: rowHeight - padding * 2,
      align: index === 0 ? "center" : index >= 2 ? "right" : "left",
      lineGap: compactLineGap(fontSize),
      ellipsis: true,
    });
    x += width;
  });
};

const drawFreeNamesRow = (
  doc: PDFKit.PDFDocument,
  items: [PdfRow, PdfRow],
  y: number,
  rowHeight: number,
  contentWidth: number,
  fontName: string,
  fontSize: number,
  padding: number,
): void => {
  const cellWidth = contentWidth / 2;
  items.forEach((item, index) => {
    const x = PAGE_MARGIN + cellWidth * index;
    doc.rect(x, y, cellWidth, rowHeight).stroke();
    doc.font(fontName).fontSize(fontSize).text(freeNameText(item), x + CELL_PADDING_X, y + padding, {
      width: cellWidth - CELL_PADDING_X * 2,
      height: rowHeight - padding * 2,
      lineGap: compactLineGap(fontSize),
    });
  });
};

const getFooterHeight = (
  doc: PDFKit.PDFDocument,
  invoice: InvoiceForPdf,
  fontNames: ReturnType<typeof selectPdfFonts>,
  contentWidth: number,
): number => {
  const amountHeight = measureTextHeight(
    doc,
    `จำนวนเงินตัวอักษร: ${invoice.amountInWords ?? "-"}`,
    contentWidth,
    fontNames.regular,
    SIZE_BODY,
  );
  const noteHeight = invoice.note
    ? measureTextHeight(doc, `หมายเหตุ: ${invoice.note}`, contentWidth, fontNames.regular, SIZE_BODY)
    : 0;
  return 6
    + SUMMARY_ROW_HEIGHT * 3
    + SUMMARY_ROW_GAP * 2
    + 5
    + amountHeight
    + (invoice.note ? 3 + noteHeight : 0)
    + 8
    + FOOTER_SIGNATURE_HEIGHT;
};

const drawFooter = (
  doc: PDFKit.PDFDocument,
  invoice: InvoiceForPdf,
  signatures: InvoiceSignatures,
  fontNames: ReturnType<typeof selectPdfFonts>,
  top: number,
  contentWidth: number,
): void => {
  let y = top;
  const rightWidth = Math.min(220, contentWidth);
  const rightX = PAGE_MARGIN + contentWidth - rightWidth;
  const totals = [
    { label: "รวมเงิน", value: formatMoney(invoice.subtotal), bold: false },
    { label: "ส่วนลด", value: formatMoney(invoice.discountTotal), bold: false },
    { label: "รวมชำระทั้งสิ้น", value: formatMoney(invoice.grandTotal), bold: true },
  ];
  totals.forEach((row, index) => {
    doc.font(row.bold ? fontNames.bold : fontNames.regular).fontSize(SIZE_BODY).text(
      `${row.label}: ${row.value}`,
      rightX,
      y,
      { width: rightWidth, height: SUMMARY_ROW_HEIGHT, align: "right", lineBreak: false },
    );
    y += SUMMARY_ROW_HEIGHT + (index < totals.length - 1 ? SUMMARY_ROW_GAP : 0);
  });
  y += 5;

  const amountText = `จำนวนเงินตัวอักษร: ${invoice.amountInWords ?? "-"}`;
  const amountHeight = measureTextHeight(doc, amountText, contentWidth, fontNames.regular, SIZE_BODY);
  doc.font(fontNames.regular).fontSize(SIZE_BODY).text(amountText, PAGE_MARGIN, y, {
    width: contentWidth,
    lineGap: compactLineGap(SIZE_BODY),
  });
  y += amountHeight;
  if (invoice.note) {
    y += 3;
    const noteText = `หมายเหตุ: ${invoice.note}`;
    const noteHeight = measureTextHeight(doc, noteText, contentWidth, fontNames.regular, SIZE_BODY);
    doc.font(fontNames.regular).fontSize(SIZE_BODY).text(noteText, PAGE_MARGIN, y, {
      width: contentWidth,
      lineGap: compactLineGap(SIZE_BODY),
    });
    y += noteHeight;
  }
  y += 8;

  const blockWidth = (contentWidth - 40) / 3;
  const labels = ["อนุมัติโดย", "ผู้รับเงิน", "ผู้จ่ายเงิน"] as const;
  const signatureData = [signatures.approvedBy, signatures.receivedBy, signatures.payer] as const;
  labels.forEach((label, index) => {
    const x = PAGE_MARGIN + index * (blockWidth + 20);
    const block = signatureData[index];
    doc.font(fontNames.bold).fontSize(SIZE_SIGNATURE).text(label, x, y, { width: blockWidth, align: "center" });
    const imageBuffer = decodeDataUrlImage(block?.imageDataUrl);
    if (imageBuffer) {
      try {
        doc.image(imageBuffer, x + (blockWidth - 82) / 2, y + 12, { fit: [82, 28], align: "center", valign: "center" });
      } catch {
        // Invalid signature image data leaves the text signature area available.
      }
    }
    doc.font(fontNames.regular).fontSize(SIZE_SIGNATURE);
    doc.text(block?.dottedText || "........................................", x, y + 40, {
      width: blockWidth,
      align: "center",
    });
    doc.text(`( ${block?.bracketText || "                                 "} )`, x, y + 52, {
      width: blockWidth,
      align: "center",
    });
  });
};

const drawOverflowWarning = (
  doc: PDFKit.PDFDocument,
  itemCount: number,
  fontName: string,
  y: number,
  width: number,
): number => {
  if (itemCount <= 40) return 0;
  const height = measureTextHeight(doc, OVERFLOW_WARNING, width, fontName, MIN_FONT_SIZE);
  doc.font(fontName).fontSize(MIN_FONT_SIZE).text(OVERFLOW_WARNING, PAGE_MARGIN, y, {
    width,
    align: "right",
    lineGap: compactLineGap(MIN_FONT_SIZE),
  });
  return height + 2;
};

const measureOverflowWarningHeight = (
  doc: PDFKit.PDFDocument,
  itemCount: number,
  fontName: string,
  width: number,
): number => itemCount > 40
  ? measureTextHeight(doc, OVERFLOW_WARNING, width, fontName, MIN_FONT_SIZE) + 2
  : 0;

export const generateInvoicePdfStream = (
  invoice: InvoiceForPdf,
  stream: NodeJS.WritableStream,
  _useAttachment?: boolean,
): void => {
  const doc = new PDFDocument({ size: INVOICE_PDF_CONFIG.pageSize, margin: PAGE_MARGIN, bufferPages: false });
  const fontNames = selectPdfFonts(doc);
  const signatures = parseSignatures(invoice.signatures);
  const contentWidth = doc.page.width - PAGE_MARGIN * 2;
  const widths = getTableWidths(doc);
  const layoutRows = arrangeInvoiceRows(invoice.items);
  const initialSettings = getInvoiceAutoFitSettings(invoice.items.length);
  const headerEnd = drawFullHeader(doc, invoice, fontNames, initialSettings.headerGap);
  const footerHeight = getFooterHeight(doc, invoice, fontNames, contentWidth);
  const footerTop = doc.page.height - PAGE_MARGIN - FOOTER_BOTTOM - footerHeight;
  const bodyBottom = footerTop - 5;
  const availableBodyHeight = bodyBottom - headerEnd;

  const measureRows = (fontSize: number, rowPadding: number): number[] =>
    layoutRows.map((row) => row.kind === "item"
      ? measureTableRowHeight(doc, row.item, widths, fontNames.regular, fontSize, rowPadding)
      : measureFreeNameRowHeight(doc, row.items, contentWidth, fontNames.regular, fontSize, rowPadding));

  let settings = initialSettings;
  let rowHeights = measureRows(settings.fontSize, settings.rowPadding);
  const overflowWarningHeight = measureOverflowWarningHeight(doc, invoice.items.length, fontNames.regular, contentWidth);
  const calculateContentHeight = (heights: number[], fontSize: number): number =>
    TABLE_HEADER_HEIGHT + heights.reduce((sum, height) => sum + height, 0)
      + (layoutRows.some((row) => row.kind === "free-names")
        ? measureFreeItemsHeadingHeight(doc, fontNames.bold, fontSize, contentWidth)
        : 0)
      + overflowWarningHeight;

  while (calculateContentHeight(rowHeights, settings.fontSize) > availableBodyHeight && settings.fontSize > MIN_FONT_SIZE) {
    settings = { ...settings, fontSize: Math.max(MIN_FONT_SIZE, settings.fontSize - 0.5) };
    rowHeights = measureRows(settings.fontSize, settings.rowPadding);
  }
  while (calculateContentHeight(rowHeights, settings.fontSize) > availableBodyHeight && settings.rowPadding > 0) {
    settings = { ...settings, rowPadding: Math.max(0, settings.rowPadding - 1) };
    rowHeights = measureRows(settings.fontSize, settings.rowPadding);
  }
  if (calculateContentHeight(rowHeights, settings.fontSize) > availableBodyHeight) {
    throw new RangeError(
      `Invoice with ${invoice.items.length} items requires ${calculateContentHeight(rowHeights, settings.fontSize).toFixed(1)}pt but only ${availableBodyHeight.toFixed(1)}pt is available at the minimum 8pt font size (header ${headerEnd.toFixed(1)}pt, footer ${footerHeight.toFixed(1)}pt)`,
    );
  }

  doc.pipe(stream);
  let y = drawTableHeader(doc, headerEnd, widths, fontNames, Math.max(MIN_FONT_SIZE, settings.fontSize));
  let freeNamesHeadingDrawn = false;
  layoutRows.forEach((row, index) => {
    const rowHeight = rowHeights[index];
    if (rowHeight === undefined) throw new RangeError("Invoice PDF row data is incomplete");
    if (row.kind === "item") {
      drawItemRow(doc, row.item, y, rowHeight, widths, fontNames, settings.fontSize, settings.rowPadding);
    } else {
      if (!freeNamesHeadingDrawn) {
        const headingHeight = measureFreeItemsHeadingHeight(doc, fontNames.bold, settings.fontSize, contentWidth);
        doc.font(fontNames.bold).fontSize(Math.max(MIN_FONT_SIZE, settings.fontSize)).text(
          FREE_ITEMS_HEADING,
          PAGE_MARGIN,
          y + FREE_ITEMS_HEADING_GAP / 2,
          { width: contentWidth, lineGap: compactLineGap(settings.fontSize), lineBreak: false },
        );
        y += headingHeight;
        freeNamesHeadingDrawn = true;
      }
      drawFreeNamesRow(doc, row.items, y, rowHeight, contentWidth, fontNames.regular, settings.fontSize, settings.rowPadding);
    }
    y += rowHeight;
  });
  if (invoice.items.length === 0) {
    doc.font(fontNames.regular).fontSize(settings.fontSize).text("ไม่มีรายการ", PAGE_MARGIN, y + 4, {
      width: contentWidth,
      align: "center",
    });
  }
  const warningHeight = drawOverflowWarning(doc, invoice.items.length, fontNames.regular, y + 2, contentWidth);
  drawFooter(doc, invoice, signatures, fontNames, doc.page.height - PAGE_MARGIN - FOOTER_BOTTOM - footerHeight, contentWidth);
  if (y + warningHeight > bodyBottom) {
    throw new RangeError("Invoice PDF layout exceeds the available A4 body area");
  }
  doc.end();
};
